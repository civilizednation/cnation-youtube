# Copy to .env.local for local development. Never upload real values to GitHub.
# Generate random values with: npm run secrets
APP_ACCESS_CODE=
APP_SECRET=
CRON_SECRET=

# Connect a PRIVATE Vercel Blob store. Vercel normally injects this token.
BLOB_READ_WRITE_TOKEN=

# Production on Vercel: Sandbox uses the project's automatic OIDC identity.
# Local development only: vercel link, then vercel env pull .env.local
# VERCEL_OIDC_TOKEN=

# Alternative for non-Vercel hosts: set ALL THREE together, server-side only.
# VERCEL_TOKEN=
# VERCEL_TEAM_ID=
# VERCEL_PROJECT_ID=

# Optional custom compatible Linux Sandbox image.
# SANDBOX_IMAGE=vercel/sandbox/universal
