{
  "name": "cnation-youtube-downloader",
  "version": "1.0.0",
  "private": true,
  "engines": { "node": ">=22.0.0" },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-isolation=none tests/*.test.mjs",
    "test:worker": "python -m unittest discover -s tests -p test_*.py",
    "test:browser": "playwright test",
    "secrets": "node scripts/generate-secrets.mjs"
  },
  "dependencies": {
    "@vercel/blob": "2.8.0",
    "@vercel/sandbox": "3.3.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.0"
  }
}
